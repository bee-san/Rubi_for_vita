{
 "what": "The stable-text wait (core/vocr_ocr.h VjoVocrPolicy.settle_us = 150 ms) on a simulated game screen: every strip read is one game frame (the display hook copies the rows from the next frame the game shows), at 60 and 30 frames a second. The job runs without weights, so the numbers are the capture and the wait up to where the model would load. Host simulation: the console's frame pacing and strip time are unmeasured (issue #81), so every ms here is an estimate.",
 "how": "cmake --build build/host --target vjo-settle-bench && build/host/vjo-settle-bench 150",
 "when": "2026-10-14T15:27Z",
 "vita_vn_ocr_runtime": "a5d5aad68bb8e719e44e2e50b5836cf9afeae796",
 "fields": {
  "frames": "strip reads until recognition would start",
  "ms": "simulated time to then",
  "first_pass_frame": "the frame whose read began the first pass the Shell is told of",
  "chars_at_first_pass": "characters of the typing line shown at that frame",
  "settle_passes": "passes read only to see whether the rows changed",
  "rc": "-115 = VJO_E_OCR_MODEL (lines found, no weights here), -120 = VJO_E_SCREEN_CHANGED",
  "strips": "strips read (each one game frame); with the wait the job sleeps instead of reading passes too early to count",
  "chars_at_published_capture": "characters of the line shown in the capture the job ended on (what it recognizes)"
 },
