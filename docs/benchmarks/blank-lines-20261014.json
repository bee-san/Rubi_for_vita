  "x2-bil-box1": "PSP rows: 2x bilinear, then a 1-pixel box blur",
  "sub720-bilin": "Vita rows: a game rendering at 720x408, upscaled bilinear to 960x544",
  "sub640-bilin": "Vita rows: rendering at 640x368, upscaled bilinear",
  "blur1.0": "a Gaussian blur, sigma 1.0 (a soft font or filter)",
  "blur1.5": "sigma 1.5"
 },
