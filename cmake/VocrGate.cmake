# The text-presence gate's weights (vita-vn-ocr #100), built into the module that runs jobs: the pinned
# release asset, checked against its SHA-256 like every runtime file (cmake/VocrOCR.cmake). Sets
# VJO_VOCR_GATE_SOURCE, a generated C file holding them as vjo_vocr_gate_blob (core/vocr_ocr.h).
# VJO_VOCR_GATE_BLOB names a local copy; without one the file is downloaded from the release (public: no token)
# into the build directory, once. Either is checked against the pinned SHA-256.
include_guard(GLOBAL)
set(VJO_VOCR_GATE_NAME textgate_p8_c8_w8.vtd)
set(VJO_VOCR_GATE_SHA256 a4e73ad78451c75a19f88a479fc0108daac85beaa88d875b73212ed3c09d85d1)
set(VJO_VOCR_GATE_URL "https://github.com/bee-san/vita-vn-ocr/releases/download/v0.3.2-textgate.1/${VJO_VOCR_GATE_NAME}")
set(VJO_VOCR_GATE_BLOB "" CACHE FILEPATH "A local copy of vita-vn-ocr's ${VJO_VOCR_GATE_NAME} (else downloaded)")
set(_gate_blob "${VJO_VOCR_GATE_BLOB}")
if(NOT _gate_blob)
  set(_gate_blob "${CMAKE_BINARY_DIR}/vita-vn-ocr/${VJO_VOCR_GATE_NAME}")
  if(NOT EXISTS "${_gate_blob}")
    file(DOWNLOAD "${VJO_VOCR_GATE_URL}" "${_gate_blob}" EXPECTED_HASH SHA256=${VJO_VOCR_GATE_SHA256} STATUS _gate_dl)
    list(GET _gate_dl 0 _gate_dl_rc)
    if(NOT _gate_dl_rc EQUAL 0)
      file(REMOVE "${_gate_blob}")
      message(FATAL_ERROR "vita-vn-ocr: cannot download ${VJO_VOCR_GATE_URL} (${_gate_dl}). Download it by hand "
        "and pass -DVJO_VOCR_GATE_BLOB=/path/to/${VJO_VOCR_GATE_NAME}.")
    endif()
  endif()
endif()
file(SHA256 "${_gate_blob}" _gate_got)
if(NOT _gate_got STREQUAL VJO_VOCR_GATE_SHA256)
  message(FATAL_ERROR "vita-vn-ocr: ${_gate_blob} has sha256 ${_gate_got}, expected ${VJO_VOCR_GATE_SHA256}")
endif()
file(READ "${_gate_blob}" _gate_hex HEX)
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _gate_bytes "${_gate_hex}")
set(_gate_c "${CMAKE_BINARY_DIR}/generated/vjo_vocr_gate_blob.c")
# The weights go in .data, not .rodata. In the debug build the worker's text pages had 3,764 B of room and its data
# pages 2,224 B: the gate's code (text, 2,592 B) and its weights (data, 1,544 B) fit them both, where both in the text
# segment would add a page to every game that is ON. The normal build's text pages had 968 B of room: it gains one
# text page either way (include/vjo_ledger_budget.h; docs/vita-vn-ocr.md, "Text-presence gate"). Nothing writes
# the weights, and vocr_textgate_load checks their CRC-32 in every job that uses them.
set(_gate_src "/* Generated by cmake/VocrGate.cmake from vita-vn-ocr's ${VJO_VOCR_GATE_NAME}\n * (sha256 ${VJO_VOCR_GATE_SHA256}): the text-presence gate's int8 weights, in .data (not const: see\n * cmake/VocrGate.cmake). */\n#include <stddef.h>\nunsigned char vjo_vocr_gate_blob[] = {${_gate_bytes}};\nconst size_t vjo_vocr_gate_blob_bytes = sizeof(vjo_vocr_gate_blob);\n")
if(EXISTS "${_gate_c}")
  file(READ "${_gate_c}" _gate_old)
else()
  set(_gate_old "")
endif()
if(NOT _gate_old STREQUAL _gate_src)
  file(WRITE "${_gate_c}" "${_gate_src}")
endif()
message(STATUS "vita-vn-ocr text-presence gate: ${_gate_blob}")
set(VJO_VOCR_GATE_SOURCE "${_gate_c}")
